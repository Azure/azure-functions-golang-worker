    "OTEL_DCE_LOGS_ENDPOINT": "https://<your-dce>.<region>.ingest.monitor.azure.com/dataCollectionRules/<dcr-immutable-id>/streams/Microsoft-OTLP-Logs/otlp/v1/logs",
    "OTEL_DCE_METRICS_ENDPOINT": "https://<your-dce>.<region>.metrics.ingest.monitor.azure.com/dataCollectionRules/<dcr-immutable-id>/streams/microsoft-otelmetrics/otlp/v1/metrics"
