FROM mcr.microsoft.com/azure-functions/bookworm/flexconsumption:4.1047.100-0-custom1.0

# Replace the entire host with a self-contained build that includes the
# skipPlaceholderInit support. This is a test-only approach to validate the
# host change before it's merged upstream.
COPY . /azure-functions-host/

# Create the native worker directory with worker.config.json including skipPlaceholderInit
RUN mkdir -p /azure-functions-host/workers/native && \
    echo '{ \
        "description": { \
            "language": "native", \
            "supportedOperatingSystems": ["LINUX"], \
            "supportedArchitectures": ["X64", "Arm64"], \
            "defaultExecutablePath": "/home/site/wwwroot/app", \
            "executableWorkingDirectory": "/home/site/wwwroot", \
            "skipPlaceholderInit": true, \
            "workerIndexing": "true" \
        }, \
        "processOptions": { \
            "initializationTimeout": "00:02:00", \
            "environmentReloadTimeout": "00:02:00" \
        } \
    }' > /azure-functions-host/workers/native/worker.config.json

ENV FUNCTIONS_WORKER_RUNTIME=native \
    FUNCTIONS_WORKER_RUNTIME_VERSION=1.0
