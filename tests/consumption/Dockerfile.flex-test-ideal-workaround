FROM mcr.microsoft.com/azure-functions/bookworm/flexconsumption:4.1047.100-0-custom1.0

# Same as Dockerfile.flex-test-ideal but clears FUNCTIONS_WORKER_RUNTIME to
# work around the host fatally failing when workerIndexing=true and the worker
# binary is missing during placeholder mode. The runtime is restored during
# specialization via the assign payload.
# TODO: Remove this Dockerfile once the host gracefully handles missing worker
# binaries in placeholder mode. At that point Dockerfile.flex-test-ideal should
# be used directly.
RUN mkdir -p /azure-functions-host/workers/native && \
    echo '{ \
        "description": { \
            "language": "native", \
            "supportedOperatingSystems": ["LINUX"], \
            "supportedArchitectures": ["X64", "Arm64"], \
            "defaultExecutablePath": "/home/site/wwwroot/app", \
            "executableWorkingDirectory": "/home/site/wwwroot", \
            "workerIndexing": "true" \
        }, \
        "processOptions": { \
            "initializationTimeout": "00:02:00", \
            "environmentReloadTimeout": "00:02:00" \
        } \
    }' > /azure-functions-host/workers/native/worker.config.json

# Intentionally NOT setting FUNCTIONS_WORKER_RUNTIME here so the host doesn't
# try to start the worker during placeholder mode.
ENV FUNCTIONS_WORKER_RUNTIME_VERSION=1.0
