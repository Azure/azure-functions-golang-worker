FROM golang:1.24 AS proxy-builder
WORKDIR /src
COPY go.mod go.sum ./
COPY sdk/ sdk/
COPY worker/ worker/
COPY proxy/ proxy/
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /proxy ./proxy/

FROM golang:1.24 AS app-builder
WORKDIR /src
COPY go.mod go.sum ./
COPY sdk/ sdk/
COPY worker/ worker/
COPY samples/httpTrigger/ samples/httpTrigger/
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /app ./samples/httpTrigger/

FROM mcr.microsoft.com/azure-functions/bookworm/flexconsumption:4.1047.100-0-custom1.0

# Dockerfile for benchmarking the direct (exec bypass) approach.
# The app binary is prebaked at /home/site/wwwroot/app. When the host starts
# the proxy, it immediately execs into the real app — zero proxy overhead.
# The host talks directly to the app with no gRPC intermediary.
RUN mkdir -p /azure-functions-host/workers/native && \
    echo '{ \
        "description": { \
            "language": "native", \
            "supportedOperatingSystems": ["LINUX"], \
            "supportedArchitectures": ["X64"], \
            "defaultExecutablePath": "/azure-functions-host/workers/native/proxy", \
            "workerIndexing": "true" \
        }, \
        "processOptions": { \
            "initializationTimeout": "00:02:00", \
            "environmentReloadTimeout": "00:02:00" \
        } \
    }' > /azure-functions-host/workers/native/worker.config.json

COPY --from=proxy-builder /proxy /azure-functions-host/workers/native/proxy
RUN chmod +x /azure-functions-host/workers/native/proxy

# Prebake the app binary so the proxy execs into it on startup
RUN mkdir -p /home/site/wwwroot
COPY --from=app-builder /app /home/site/wwwroot/app
RUN chmod +x /home/site/wwwroot/app

ENV FUNCTIONS_WORKER_RUNTIME=native \
    FUNCTIONS_WORKER_RUNTIME_VERSION=1.0
