FROM mcr.microsoft.com/azure-functions/bookworm/flexconsumption:4.1047.100-0-custom1.0

# Set the worker runtime and point the host at /home/site/wwwroot for the
# worker config. The worker.config.json is deployed as part of the user's
# app package, not baked into the image. During placeholder mode the host sees
# FUNCTIONS_WORKER_RUNTIME=native but finds no worker.config.json at the
# configured workerDirectory — it gracefully skips worker initialization.
# After specialization the app is deployed and the host discovers the config.
ENV FUNCTIONS_WORKER_RUNTIME=native \
    FUNCTIONS_WORKER_RUNTIME_VERSION=1.0 \
    languageWorkers__native__workerDirectory=/home/site/wwwroot
